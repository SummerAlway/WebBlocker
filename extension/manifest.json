{
  "manifest_version": 3,
  "name": "WebBlocker 网站屏蔽",
  "version": "1.0.0",
  "description": "自动同步 WebBlocker 主程序的网站列表，屏蔽域名及其所有子域名。",
  "minimum_chrome_version": "101",
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WebBlocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
